{
  "name": "@euro/mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Native shell for the EURO TRADE web app. Replaces the Flutter WebView project (euroapp).",
  "scripts": {
    "build:web": "npm --workspace @euro/web run build:static",
    "sync": "npm run build:web && cap sync && npm run postsync",
    "open:android": "cap open android",
    "open:ios": "cap open ios",
    "run:android": "npm run sync && cap run android",
    "postsync": "node ../../scripts/disable-webview-scrollbars.mjs android"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/local-notifications": "^7.0.7",
    "@capacitor/splash-screen": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.0.0",
    "typescript": "^5.7.2"
  }
}
