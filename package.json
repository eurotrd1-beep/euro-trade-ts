{
  "name": "euro-trade",
  "private": true,
  "version": "1.0.0",
  "description": "EURO TRADE — unified TypeScript monorepo (web, admin, mobile, backend).",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:reference": "tsx scripts/build-strategy-reference.mts && node -e \"require('fs').copyFileSync('docs/strategy-reference.json','apps/web/public/strategy-reference.json')\"",
    "check:strategies": "tsx scripts/check-live-strategies.mts",
    "build:engine-bundle": "node scripts/build-engine-bundle.mjs"
  }
}
