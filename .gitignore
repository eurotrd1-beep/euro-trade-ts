# dependencies
node_modules/
.pnp
.pnp.js

# builds
.next/
out/
dist/
build/
*.tsbuildinfo

# Capacitor native projects — regenerated by `cap sync`, and they carry
# machine-specific paths that create noise in every diff.
apps/mobile/android/
apps/mobile/ios/

# the Dart parity harness pulls its own packages
tools/golden-dart/.dart_tool/
tools/golden-dart/build/
tools/golden-dart/.packages

# Cloudflare
.wrangler/
.dev.vars

# env — never commit secrets. SUPABASE_SERVICE_KEY in particular belongs in
# the deployment platform's environment, not in the repo.
.env
.env.local
.env*.local

# editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# logs
*.log
npm-debug.log*

# Built APKs — artefacts, not source.
*.apk
